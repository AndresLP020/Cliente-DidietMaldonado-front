# =============================================================================
# ReaperSys — Frontend
# Copie como `.env.local`. Las variables NEXT_PUBLIC_* se incrustan en el
# bundle del navegador: NUNCA coloque secretos aquí.
# =============================================================================

# URL base de la API (incluye prefijo y versión).
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# URL pública del sitio (metadata, Open Graph, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Los datos de contacto y redes se administran en /admin/configuracion (no aquí).

# --- Solo servidor (opcional) -------------------------------------------------
# URL interna de la API para Server Components (p. ej. red de Docker).
# Si se omite, se usa NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=
